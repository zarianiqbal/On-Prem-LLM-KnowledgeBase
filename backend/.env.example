# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Environment ---
# "development" (default) or "production". In production the app REFUSES to start
# with unsafe config: a default JWT_SECRET, or DEV_AUTH_ENABLED left on.
ENVIRONMENT=development

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+psycopg2://kb_user:kb_password@localhost:5432/knowledge_base

# --- JWT / auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# In dev, allow logging in by simply choosing a role (no Google account needed).
# Set to false in production once Google OAuth is configured.
DEV_AUTH_ENABLED=true

# Role assigned to any authenticated user with no roles (least privilege).
# These users see only public documents + documents tagged with this role.
DEFAULT_ROLE=customer

# --- Embedding model (runs locally via sentence-transformers) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking / retrieval ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
# Hard ceiling on a client-supplied top_k, so a caller can't request a huge
# number of chunks and blow up the prompt / DB work.
MAX_RETRIEVAL_TOP_K=20

# --- Request limits (resource / abuse guards) ---
MAX_UPLOAD_MB=25        # reject document uploads larger than this
MAX_QUERY_CHARS=4000    # reject chat questions longer than this

# --- LLM backend ---
# "ollama" = real local model (needs Ollama running + a GPU for good speed).
# "mock"   = canned demo output so you can test the app WITHOUT installing
#            Ollama or having a GPU. (Postgres + the embedding model are still
#            needed; those run fine on CPU.)
LLM_PROVIDER=ollama

# --- Ollama (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Abuse hardening ---
# Scan uploaded docs for prompt-injection phrases (e.g. "ignore all previous
# instructions"). Flagged docs are still ingested but recorded in the audit log.
INJECTION_SCAN_ENABLED=true
# In-memory rate limiting. Chat is limited per user, login per IP. Returns HTTP
# 429 once exceeded. Single-process only (fine for the local/self-hosted MVP).
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# --- CORS: where the frontend is served from ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console, set
# the consent screen to "Internal", and add the redirect URI below as an
# authorized redirect URI. Leave blank to disable Google login (dev-login only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Comma-separated emails auto-granted admin on Google login. Set at least one so
# a fresh install has a way in (that person can then assign everyone else).
ADMIN_EMAILS=
