# ------------------------------------------------------------------
# Copy this to `.env.production` and fill in real values. NEVER commit it.
# Used by docker-compose.prod.yml:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# ENVIRONMENT=production and DEV_AUTH_ENABLED=false are set by the compose file,
# so the backend refuses to start if JWT_SECRET below is left at a default.
# ------------------------------------------------------------------

# --- Database ---
# Password for the Postgres user (kb_user). Used for both the DB container and
# the backend's DATABASE_URL (which compose builds for you).
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Auth / JWT ---
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Public URL ---
# The origin browsers use to reach the app. Must be your real domain in
# production — the post-Google-login redirect sends users back here.
FRONTEND_ORIGIN=https://kb.yourcompany.com

# --- Google OAuth ---
# The only real login method in production (dev-login is disabled). The redirect
# URI must match what you register in Google Cloud Console, and point at your
# public /api callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kb.yourcompany.com/api/auth/google/callback

# Comma-separated emails auto-granted admin on first login (bootstrap admin).
ADMIN_EMAILS=you@yourcompany.com

# --- LLM backend ---
# "ollama" (real, needs `ollama serve` on the host) or "mock" (no LLM/GPU).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
